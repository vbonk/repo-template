#!/usr/bin/env bash
# Pre-commit hook: blocks commits containing secrets or forbidden tokens.
# Install: cp templates/hooks/pre-commit-secrets.sh.template .git/hooks/pre-commit && chmod +x .git/hooks/pre-commit
# Or run: bash templates/hooks/setup-hooks.sh
set -euo pipefail

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
NC='\033[0m'

REPO_ROOT="$(git rev-parse --show-toplevel)"
TOKENS_FILE="$REPO_ROOT/.git/hooks/forbidden-tokens.txt"
BLOCKED=0

echo "=== Pre-commit security check ==="

# --- Check 1: Forbidden tokens (from file + dynamic username) ---
TOKENS=()

# Dynamic: detect local username across platforms
for var in USER LOGNAME USERNAME; do
  val="${!var:-}"
  if [[ -n "$val" ]]; then
    TOKENS+=("$val")
  fi
done

# From file (if exists)
if [[ -f "$TOKENS_FILE" ]]; then
  while IFS= read -r line; do
    line="${line%%#*}"
    line="$(echo "$line" | xargs 2>/dev/null || echo "$line")"
    [[ -z "$line" ]] && continue
    TOKENS+=("$line")
  done < "$TOKENS_FILE"
fi

# Deduplicate (while-read instead of mapfile: must stay bash 3.2 compatible)
if [[ ${#TOKENS[@]} -gt 0 ]]; then
  DEDUPED=()
  while IFS= read -r token; do
    DEDUPED+=("$token")
  done < <(printf '%s\n' "${TOKENS[@]}" | sort -u)
  TOKENS=("${DEDUPED[@]}")
fi

# Get staged files (exclude binaries and lock files)
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACMR -- \
  ':!pnpm-lock.yaml' ':!package-lock.json' ':!yarn.lock' ':!Cargo.lock' ':!go.sum' \
  ':!*.png' ':!*.jpg' ':!*.jpeg' ':!*.gif' ':!*.ico' ':!*.webp' \
  ':!*.woff' ':!*.woff2' ':!*.ttf' ':!*.eot' ':!*.svg' \
  ':!*.zip' ':!*.tar' ':!*.gz' ':!*.pdf' 2>/dev/null || true)

# Scan staged files for forbidden tokens
if [[ -n "$STAGED_FILES" && ${#TOKENS[@]} -gt 0 ]]; then
  for token in "${TOKENS[@]}"; do
    matches=$(echo "$STAGED_FILES" | while IFS= read -r f; do
      [[ -z "$f" ]] && continue
      git show ":$f" 2>/dev/null | grep -in -- "$token" | while IFS= read -r match; do
        echo "  $f:$match"
      done
    done || true)

    if [[ -n "$matches" ]]; then
      if [[ $BLOCKED -eq 0 ]]; then
        echo -e "${RED}BLOCKED: Forbidden tokens found in staged files:${NC}"
      fi
      echo -e "${YELLOW}  Token: ${token}${NC}"
      echo "$matches"
      BLOCKED=1
    fi
  done
fi

# --- Check 2: Secret patterns (regex) ---
# Uses [[:space:]] for POSIX compatibility (works on macOS BSD grep and GNU grep).
# NOTE: quote characters appear as ['\''"] built via shell quoting — do NOT
# use \x27 escapes: BSD grep does not understand them, which silently broke
# single-quoted secret detection on macOS for months.
#
# Two groups with different file scopes:
# PRECISE — provider token formats. Near-zero false positives, so these scan
# ALL staged files including docs (.md/.txt): a real key pasted into a README
# is just as leaked.
SECRET_PATTERNS_PRECISE=(
  'PRIVATE.KEY'
  'BEGIN RSA'
  'BEGIN OPENSSH'
  'BEGIN EC PRIVATE'
  'BEGIN PGP PRIVATE'
  'AKIA[A-Z0-9]{16}'
  'gh[pos]_[a-zA-Z0-9]{36}'
  'github_pat_[A-Za-z0-9_]{22,}'
  'gh[ur]_[A-Za-z0-9]{36,}'
  'sk-ant-[a-zA-Z0-9-]+'
  'sk-proj-[a-zA-Z0-9]+'
  'sk_live_[0-9a-zA-Z]{24,}'
  'xox[baprs]-[A-Za-z0-9-]{10,}'
  'AIza[0-9A-Za-z_-]{35}'
  'npm_[A-Za-z0-9]{36}'
  'eyJ[A-Za-z0-9_-]{20,}\.eyJ'
)
# GENERIC — password/secret/token assignments. Prose-prone, so docs are
# skipped. Values may be double- OR single-quoted (both grep flavors).
SECRET_PATTERNS_GENERIC=(
  'password[[:space:]]*[:=][[:space:]]*["'\''][^"'\'']{8,}'
  'secret[[:space:]]*[:=][[:space:]]*["'\''][^"'\'']{8,}'
  'api[_-]?key[[:space:]]*[:=][[:space:]]*["'\''][^"'\'']{8,}'
  'token[[:space:]]*[:=][[:space:]]*["'\''][^"'\'']{8,}'
  'aws_access_key_id[[:space:]]*='
  'aws_secret_access_key[[:space:]]*='
)

scan_patterns() {
  # $1 = "precise" | "generic" — controls the doc-file skip
  local group="$1"; shift
  local pattern matches
  for pattern in "$@"; do
    matches=$(echo "$STAGED_FILES" | while IFS= read -r f; do
      [[ -z "$f" ]] && continue
      # Files that legitimately contain secret patterns (examples, security tooling)
      case "$f" in
        (*.example|*.template) continue ;;
        (templates/hooks/*|.github/workflows/*|scripts/test-template.sh|scripts/test-e2e.sh|.gitignore|.gitattributes) continue ;;
      esac
      if [[ "$group" == "generic" ]]; then
        case "$f" in
          (*.md|*.txt|*.rst) continue ;;
        esac
      fi
      git show ":$f" 2>/dev/null | grep -iEn -- "$pattern" | while IFS= read -r match; do
        echo "  $f:$match"
      done
    done || true)

    if [[ -n "$matches" ]]; then
      if [[ $BLOCKED -eq 0 ]]; then
        echo -e "${RED}BLOCKED: Possible secrets detected in staged files:${NC}"
      fi
      echo -e "${YELLOW}  Pattern: ${pattern}${NC}"
      echo "$matches"
      BLOCKED=1
    fi
  done
}

if [[ -n "$STAGED_FILES" ]]; then
  scan_patterns precise "${SECRET_PATTERNS_PRECISE[@]}"
  scan_patterns generic "${SECRET_PATTERNS_GENERIC[@]}"
fi

# --- Check 3: .env files ---
ENV_FILES=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '\.env($|\.)' | grep -v '\.example' || true)
if [[ -n "$ENV_FILES" ]]; then
  echo -e "${RED}BLOCKED: .env file(s) staged for commit:${NC}"
  echo "$ENV_FILES"
  BLOCKED=1
fi

# --- Result ---
if [[ $BLOCKED -ne 0 ]]; then
  echo ""
  echo -e "${RED}Commit blocked. Fix the issues above, then try again.${NC}"
  echo "If a detection is a false positive, you can:"
  echo "  1. Add an exclusion pattern to the hook"
  echo "  2. Use 'git commit --no-verify' (use sparingly and document why)"
  exit 1
fi

echo -e "${GREEN}All checks passed.${NC}"
exit 0
